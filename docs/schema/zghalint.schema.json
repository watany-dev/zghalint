{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/watany-dev/zghalint/blob/main/docs/schema/zghalint.schema.json",
  "title": "zghalint configuration",
  "description": "Schema for .zghalint.yml. Generated by scripts/gen-config-schema.py from src/config.zig.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "rules": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "severity": {
            "type": "string",
            "enum": [
              "error",
              "warning",
              "info",
              "hint"
            ]
          },
          "enabled": {
            "type": "boolean"
          },
          "exclude": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "node_cache_manager": {
            "type": "string",
            "enum": [
              "npm",
              "yarn",
              "pnpm"
            ]
          },
          "python_cache_manager": {
            "type": "string",
            "enum": [
              "pip",
              "pipenv",
              "poetry"
            ]
          }
        }
      }
    },
    "ignore": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "runner": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "labels": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "output": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "format": {
          "type": "string",
          "enum": [
            "terminal",
            "json",
            "sarif",
            "github"
          ]
        },
        "color": {
          "type": "string",
          "enum": [
            "auto",
            "always",
            "never"
          ]
        }
      }
    },
    "repo_visibility": {
      "type": "string",
      "enum": [
        "public",
        "private",
        "unknown"
      ]
    }
  }
}
