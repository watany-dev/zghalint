# zghalint:expect SEC010
name: local inherit
on: push
permissions:
  contents: read
concurrency:
  group: ${{ github.workflow }}-${{ github.ref }}
  cancel-in-progress: true
jobs:
  call:
    uses: ./tests/fixtures/e2e/reusable/deploy.yml
    secrets:
      npm_token: ${{ secrets.npm_token }}
      api_key: ${{ secrets.api_key }}
