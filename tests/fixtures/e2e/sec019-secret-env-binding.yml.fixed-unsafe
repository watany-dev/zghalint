# zghalint:expect SEC019
# #327: `--fix-unsafe` binds the secret to the step's `env:`. The `cmd` step
# picks its reference form up from `shell:`, and the `with:` step keeps its
# diagnostic without a fix because only `run:` bodies are rewritten.
name: Secret env binding
on:
  push:
    branches: [main]
permissions:
  contents: read
concurrency:
  group: secret-env-binding
jobs:
  posix:
    runs-on: ubuntu-latest
    timeout-minutes: 5
    steps:
      - env:
          NPM_TOKEN: ${{ secrets.NPM_TOKEN }}
        name: Publish
        run: npm publish --token "$NPM_TOKEN"
  cmd:
    runs-on: windows-latest
    timeout-minutes: 5
    steps:
      - env:
          NPM_TOKEN: ${{ secrets.NPM_TOKEN }}
        name: Publish from cmd
        shell: cmd
        run: publish.exe --token "%NPM_TOKEN%"
  with-only:
    runs-on: ubuntu-latest
    timeout-minutes: 5
    steps:
      - name: Pass the secret to an action
        uses: actions/github-script@60a0d83039c74a4aee543508d2ffcb1c3799cdea # v7.0.1
        with:
          github-token: ${{ secrets.CUSTOM_TOKEN }}
          script: console.log('ok')
