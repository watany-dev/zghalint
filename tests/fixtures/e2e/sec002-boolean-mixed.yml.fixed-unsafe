# zghalint:expect SEC002
name: mixed output
on:
  issues:
    types: [opened]
permissions: {}
concurrency: test
jobs:
  check:
    runs-on: ubuntu-latest
    timeout-minutes: 10
    steps:
      - env:
          ISSUE_TITLE: ${{ github.event.issue.title }}
        name: Mixed expressions
        run: |
          echo "${{ startsWith(github.event.issue.title, 'fix') }}"
          echo "$ISSUE_TITLE"
