{
  "effortLevel": "high",
  "language": "japanese",
  "autoMemoryEnabled": false,
  "env": {
    "CLAUDE_CODE_DISABLE_1M_CONTEXT": "1"
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash scripts/setup-zig.sh"
          }
        ]
      }
    ]
  },
  "permissions": {
    "allow": [
      "Bash(zig build:*)",
      "Bash(zig fmt:*)",
      "Bash(zig build test:*)",
      "Bash(zig build run:*)",
      "Bash(git:*)"
    ]
  }
}
